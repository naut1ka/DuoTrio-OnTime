            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "description": "Active reports within 0.01 degrees of the query point. expires is Unix time in seconds."
      }
