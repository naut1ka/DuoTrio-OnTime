    "/predict": {
      "post": {
        "security": [
          {
            "Bearer": []
          },
          {
            "PartnerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "targetArrival": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "slots": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Slot"
                      }
                    },
                    "latestSafe": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Slot"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fastest": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Slot"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bufferMinutes": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "targetArrival",
                    "slots",
                    "latestSafe",
                    "fastest",
                    "bufferMinutes"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "origin": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[lat, lon]"
                  },
                  "destination": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[lat, lon]"
                  },
                  "vehicle": {
                    "type": "string",
                    "enum": [
                      "car",
                      "motorcycle"
                    ]
                  },
                  "targetArrival": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "origin",
                  "destination",
                  "vehicle",
                  "targetArrival"
                ]
              },
              "example": {
                "origin": [
                  -6.88,
                  107.62
                ],
                "destination": [
                  -6.89,
                  107.61
                ],
                "vehicle": "motorcycle",
                "targetArrival": "2026-11-27T07:00:00+07:00"
              }
            }
          }
        },
        "description": "Evaluate future WIB quarter-hour slots in the three hours before targetArrival. Target must be within seven days. Times include UTC offset. latestSafe and fastest are null if no evaluated slot meets the target with five minutes of margin. Missing OSRM data can omit slots."
      }
    },
