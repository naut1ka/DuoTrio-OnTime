                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "lat": {
                            "type": "number"
                          },
                          "lon": {
                            "type": "number"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "expires": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "id",
                          "lat",
                          "lon",
                          "kind",
                          "expires"
                        ]
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
