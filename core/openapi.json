{
  "openapi": "3.1.0",
  "info": {
    "title": "OnTime API",
    "version": "1.0.0",
    "description": "Coordinate arrays are [latitude, longitude]. Use Asia/Jakarta for local schedules. One API key per partner group. Login tokens expire in 24 hours."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "Slot": {
        "type": "object",
        "properties": {
          "departure": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "personal",
              "collective",
              "osrm"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "weatherAvailable": {
            "type": "boolean"
          },
          "meetsTarget": {
            "type": "boolean"
          }
        },
        "required": [
          "departure",
          "durationMinutes",
          "source",
          "confidence",
          "weatherAvailable",
          "meetsTarget"
        ]
      },
      "FavoriteInput": {
        "type": "object",
        "required": [
          "name",
          "location"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Kos"
          },
          "location": {
            "type": "array",
            "description": "[latitude, longitude]",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            ],
            "example": [
              -6.8893,
              107.6101
            ]
          }
        }
      },
      "Favorite": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FavoriteInput"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "PartnerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
